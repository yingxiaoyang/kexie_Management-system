NODE_ENV=development
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kexie_db
DB_USER=kexie_user
DB_PASSWORD=replace_with_database_password
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=kexie_session

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=256kb
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
ADMIN_LOGIN_RATE_LIMIT_MAX=10
ACCOUNT_LOCK_MINUTES=15
ADMIN_ACCOUNT_LOCK_MINUTES=30

UPLOAD_ROOT=../storage/uploads
EXPORT_ROOT=../storage/exports
ARCHIVE_WORKER_ENABLED=true
ARCHIVE_WORKER_POLL_MS=2000
ARCHIVE_WORKER_HEARTBEAT_MS=5000
ARCHIVE_WORKER_TIMEOUT_MS=300000
ARCHIVE_EXPORT_MAX_ATTEMPTS=3
ARCHIVE_EXPORT_MAX_QUEUED=5
ARCHIVE_EXPORT_MAX_PROJECTS=300
ARCHIVE_EXPORT_MAX_TOTAL_MB=2048
ARCHIVE_EXPORT_MIN_FREE_MB=1024
ARCHIVE_ZIP_RETENTION_DAYS=30
IMPORT_BATCH_RETENTION_HOURS=24
MAX_UPLOAD_FILE_MB=50
MAX_TASK_PROJECT_UPLOAD_MB=500
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,zip

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe123!
